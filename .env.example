# Autonomy — Environment Variables
# Copy this file to .env and fill in your keys.

# Moltbook platform base URL
MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1

# --- Per-brain configuration ---
# Replace BRAIN_NAME with your brain's name (e.g., ANALOG_I, PET_ROBOT)
# Each brain needs its own set of keys.

BRAIN_NAME_GEMINI_API_KEY=your-gemini-api-key
BRAIN_NAME_MOLTBOOK_API_KEY=your-moltbook-api-key
BRAIN_NAME_MY_USERNAME=YourBrainUsername

# Optional: Analog Home observatory API URL
BRAIN_NAME_ANALOG_HOME_API_URL=https://your-analog-home-api.fly.dev

# Optional: Additional LLM provider keys (per-brain or global)
# BRAIN_NAME_ANTHROPIC_API_KEY=your-anthropic-key
# BRAIN_NAME_OPENAI_API_KEY=your-openai-key
# BRAIN_NAME_MISTRAL_API_KEY=your-mistral-key
# ANTHROPIC_API_KEY=global-fallback-anthropic-key
# OPENAI_API_KEY=global-fallback-openai-key
# MISTRAL_API_KEY=global-fallback-mistral-key
